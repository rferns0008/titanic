# Ignore local development and generated artifacts that are not part of the DVC data graph.
# Keep DVC-tracked data directories such as data/ available for versioning via data.dvc.

.venv/
.venv.nosync/
.vscode/
.idea/
.DS_Store
*.swp

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

models/
outputs/
*.pkl

.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Ignore temporary local caches
cache/
tmp/
