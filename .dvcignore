# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Ignore environment and editor files
.venv/
.venv.nosync/
.vscode/
.idea/
.DS_Store
*.swp

# Ignore Python artifacts
__pycache__/
*.py[cod]
*$py.class

# Ignore outputs and models that are generated by training
models/
outputs/

# Ignore local credentials and caches
.dvc/config.local

# Ignore data directories that are not tracked by DVC
tmp/
cache/
